generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?
  googleId  String?  @unique
  name      String?
  role           String   @default("customer") // customer, company, worker, admin
  mfaEnabled     Boolean  @default(false)
  mfaCode        String?
  mfaCodeExpires DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Booking {
  id            Int      @id @default(autoincrement())
  serviceId     String
  serviceName   String
  customerEmail String?
  date          String
  status        String   @default("pending")
  createdAt     DateTime @default(now())
}
